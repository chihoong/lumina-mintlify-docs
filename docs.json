{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lumina",
  "description": "Set up your Lumina self-ordering kiosk, manage your menu, and delight guests from day one.",
  "colors": {
    "primary": "#0027F5",
    "light": "#1BE7FF",
    "dark": "#E6FF4F"
  },
  "favicon": "/logo/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Help",
          "icon": "life-buoy",
          "href": "mailto:support@onlumina.com"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Get Started",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "introduction",
          "quick-start"
        ]
      },
      {
        "group": "Kiosk Setup",
        "icon": "monitor",
        "expanded": true,
        "pages": [
          "kiosk-operations",
          "menu-management",
          "loyalty"
        ]
      },
      {
        "group": "Guides",
        "icon": "book-open",
        "expanded": true,
        "pages": [
          "migrating",
          "troubleshooting"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://onlumina.com"
  },
  "navbar": {
    "links": []
  },
  "footer": {
    "socials": {}
  }
}
